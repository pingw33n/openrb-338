# Everything is text with LF on every platform (also on Windows checkouts): the tests and
# hashes that read the JSON/SVG/TSV fixtures, and the shell scripts, depend on it. This line is
# first: git applies the last matching line, so the binary rules below override it.
* text=auto eol=lf

*.i64 binary
*.rbs binary
*.rbm binary
*.wav binary
*.flac binary
*.aif binary
*.png binary
*.bin binary
*.dll binary
*.exe binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.ico binary
*.icns binary
*.zip binary
*.gz binary
*.dmg binary
*.ogg binary

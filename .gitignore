# The original program and its IDA databases are copyrighted: local, never in git
# (original/README.md and ida/README.md say what goes there). This also covers IDA's
# working files of an open database (*.id0 ...), which sit next to the .i64.
/original/*
!/original/README.md
/ida/*
!/ida/README.md

# IDA's working files of an open database anywhere else (unpacked from the .i64)
*.id0
*.id1
*.id2
*.nam
*.til
*.$$$
*.i64
*.idb

# Rust build output
/target/

# Agent worktrees, editor and OS files
.claude/worktrees/
.idea/
.vscode/
.DS_Store

# rbhost build output (tools/rbhost/build.sh)
/tools/rbhost/build/

# Python bytecode caches
__pycache__/

# Disassembly listings of the original (llvm-objdump output), local only
/text.s
*.asm

# Packages built by scripts/ (task-108)
/dist/
